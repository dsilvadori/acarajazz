{
  "name": "acarajazz",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "check": "astro check",
    "db:migrate": "wrangler d1 migrations apply acarajazz --local",
    "db:seed": "wrangler d1 execute acarajazz --local --file=db/seed.sql",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate && npm run db:seed",
    "cf-typegen": "wrangler types",
    "deploy": "astro build && wrangler deploy",
    "db:migrate:remoto": "wrangler d1 migrations apply acarajazz --remote",
    "db:seed:remoto": "wrangler d1 execute acarajazz --remote --file=db/seed.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.8",
    "astro": "^7.4.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "^6.0.3",
    "wrangler": "^4.162.0"
  }
}
