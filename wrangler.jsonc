{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "acarajazz",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "acarajazz",
      // Trocar pelo ID real após `npx wrangler d1 create acarajazz` (ver docs/ARQUITETURA.md)
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "db/migrations"
    }
  ],
  // Aviso de novos leads por e-mail (exige Email Routing ativo no domínio oacarajazz.com)
  "send_email": [
    { "name": "EMAIL", "destination_address": "acarajazz.contato@gmail.com" }
  ],
  "vars": {
    "EMAIL_REMETENTE": "site@oacarajazz.com",
    "EMAIL_DESTINO": "acarajazz.contato@gmail.com",
    // Chave pública do Turnstile. Esta é a chave de TESTE da Cloudflare (sempre aprova); trocar na produção.
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    // Cloudflare Access do /admin (preencher ao configurar o Access; vazio = /admin bloqueado em produção)
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  }
  // Segredos (não ficam aqui): TURNSTILE_SECRET, INSTAGRAM_TOKEN → `wrangler secret put` ou .dev.vars
}
