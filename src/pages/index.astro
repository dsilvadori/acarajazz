---
import Base from '../layouts/Base.astro';
import Cabecalho from '../components/Cabecalho.astro';
import Hero from '../components/Hero.astro';
import Destaques from '../components/Destaques.astro';
import Cardapio from '../components/Cardapio.astro';
import Horarios from '../components/Horarios.astro';
import Delivery from '../components/Delivery.astro';
import SobreBia from '../components/SobreBia.astro';
import ChamadaCurso from '../components/ChamadaCurso.astro';
import ChamadaAcarabet from '../components/ChamadaAcarabet.astro';
import NaMidia from '../components/NaMidia.astro';
import Avaliacoes from '../components/Avaliacoes.astro';
import Eventos from '../components/Eventos.astro';
import Instagram from '../components/Instagram.astro';
import Rodape from '../components/Rodape.astro';
import { getCardapio, getHorarios, getAvisoAtivo } from '../lib/db';
import { agoraSP, statusAgora } from '../lib/horario';
import { schemaRestaurante } from '../lib/seo';

const [categorias, horarios, aviso] = await Promise.all([
  getCardapio(),
  getHorarios(),
  getAvisoAtivo(agoraSP().dataISO),
]);
const status = statusAgora(horarios);

// O status "aberto agora" muda com o tempo: cache curto na borda.
if (import.meta.env.PROD) Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=300');
---

<Base schema={schemaRestaurante(Astro.site!, Astro.url.origin, horarios)}>
  <Cabecalho />
  <Hero status={status} />
  <main>
    <Destaques categorias={categorias} />
    <Cardapio categorias={categorias} />
    <Delivery />
    <Horarios horarios={horarios} status={status} aviso={aviso} />
    <SobreBia />
    <ChamadaCurso />
    <NaMidia />
    <Avaliacoes />
    <ChamadaAcarabet />
    <Eventos />
    <Instagram />
  </main>
  <Rodape />
</Base>
