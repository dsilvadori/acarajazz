---
// Prévia interna dos sprites do jogo (não aparece no Google).
// Sprites gerados por tools/sprites/bia.py (Bia) e tools/sprites/personagens.py (easter eggs)
import Base from '../../layouts/Base.astro';
import salao from '../../data/acarabet/salao.json';

const ESCALA = 6;
const roupas = [
  { id: 'baiana', nome: 'Baiana', desc: 'Turbante, bata de renda e saia rodada' },
  { id: 'dolma', nome: 'Dólmã laranja', desc: 'Chef de cozinha, lencinho claro com nozinho na frente' },
  { id: 'preta', nome: 'Despojada', desc: 'Camiseta preta com o acarajé do logo, lenço e tênis' },
];
const animacoes = [
  { arquivo: 'parada_2q', nome: 'Parada (respirando)', quadros: 2, fps: 2 },
  { arquivo: 'andando_4q', nome: 'Andando', quadros: 4, fps: 8 },
  { arquivo: 'mexendo_4q', nome: 'Mexendo a panela', quadros: 4, fps: 8 },
  { arquivo: 'batendo_4q', nome: 'Batendo a massa', quadros: 4, fps: 10 },
  { arquivo: 'provando_3q', nome: 'Provando', quadros: 3, fps: 3 },
  { arquivo: 'comemorando_4q', nome: 'Comemorando', quadros: 4, fps: 8 },
  { arquivo: 'preocupada_2q', nome: 'Preocupada (algo queimou)', quadros: 2, fps: 4 },
  { arquivo: 'andando_lado_6q', nome: 'Andando de lado', quadros: 6, fps: 10 },
  { arquivo: 'servindo_lado_6q', nome: 'Servindo de lado (com a bandeja)', quadros: 6, fps: 10 },
  { arquivo: 'servindo_4q', nome: 'Servindo de frente (com a bandeja)', quadros: 4, fps: 8 },
  { arquivo: 'andando_costas_4q', nome: 'Andando de costas', quadros: 4, fps: 8 },
];
const pos = salao.posicoes;
const gato = pos.por_do_sol[0];
const cena = [
  { s: 'npc_eliana_parada_2q', q: 2, fps: 2, ...pos.eliana },
  { s: 'npc_tios_mesa_parada_2q', q: 2, fps: 2, w: 64, ...pos.tios_mesa },
  { s: 'npc_gemea_mae_parada_2q', q: 2, fps: 2, ...pos.gemea_mae },
  { s: 'npc_gemea_tia_parada_2q', q: 2, fps: 2, ...pos.gemea_tia },
  { s: 'npc_valentina_parada_2q', q: 2, fps: 2, ...pos.valentina },
  { s: 'gato_sentado_4q', q: 4, fps: 4, w: 24, h: 17, x: gato.x, y: gato.y },
];
const easterEggs = [
  { arquivo: 'npc_eliana_parada_2q', nome: 'Eliana', desc: 'Chef e sócia', quadros: 2, fps: 2 },
  { arquivo: 'npc_eliana_acenando_2q', nome: 'Eliana acenando', desc: 'Ao tocar nela', quadros: 2, fps: 4 },
  { arquivo: 'npc_gemea_mae_parada_2q', nome: 'Gêmea (mãe)', desc: 'Blusa de renda e contas vermelhas', quadros: 2, fps: 2 },
  { arquivo: 'npc_gemea_mae_acenando_2q', nome: 'Gêmea (mãe) acenando', desc: 'Ao tocar nela', quadros: 2, fps: 4 },
  { arquivo: 'npc_gemea_tia_parada_2q', nome: 'Gêmea (tia)', desc: 'Camiseta branca e pingente de madeira', quadros: 2, fps: 2 },
  { arquivo: 'npc_gemea_tia_acenando_2q', nome: 'Gêmea (tia) acenando', desc: 'Ao tocar nela', quadros: 2, fps: 4 },
  { arquivo: 'npc_valentina_parada_2q', nome: 'Valentina', desc: 'Filha', quadros: 2, fps: 2 },
  { arquivo: 'npc_valentina_acenando_2q', nome: 'Valentina acenando', desc: 'Ao tocar nela', quadros: 2, fps: 4 },
  { arquivo: 'npc_vic_lavando_4q', nome: 'Vic', desc: 'Irmão da Bia, lavando louça atrás do balcão (não reage)', quadros: 4, fps: 4 },
  { arquivo: 'npc_tios_mesa_parada_2q', nome: 'Tio Luizinho e Toninho', desc: 'Na mesa, com acarajé e cerveja', quadros: 2, fps: 2, w: 64 },
  { arquivo: 'npc_tios_mesa_brindando_3q', nome: 'Brindando', desc: 'Ao tocar neles', quadros: 3, fps: 4, w: 64 },
  { arquivo: 'cliente_casal_esperando_2q', nome: 'Casal (clientes)', desc: 'Esperando o pedido', quadros: 2, fps: 2, w: 64 },
  { arquivo: 'cliente_casal_feliz_3q', nome: 'Casal: chegou!', desc: 'Quando a Bia serve', quadros: 3, fps: 5, w: 64 },
  { arquivo: 'cliente_casal_comendo_4q', nome: 'Casal comendo', desc: 'Depois de servidos', quadros: 4, fps: 4, w: 64 },
  { arquivo: 'gato_sentado_4q', nome: 'Pôr do Sol', desc: 'Sentado, balançando o rabo', quadros: 4, fps: 4, w: 24, h: 17 },
  { arquivo: 'gato_dormindo_2q', nome: 'Pôr do Sol dormindo', desc: 'Num cantinho do cenário', quadros: 2, fps: 1, w: 24, h: 17 },
];
---

<Base title="Sprites do Acarabet" noindex>
  <main class="pagina">
    <h1>Sprites da Bia</h1>
    <p class="sub">Prévia interna do jogo Acarabet · 32×48 px por quadro, ampliado {ESCALA}×.</p>

    <div class="fundos" role="group" aria-label="Fundo">
      <button type="button" data-fundo="#fef5e2" class="ativo">Creme</button>
      <button type="button" data-fundo="#ff9a2e">Laranja</button>
      <button type="button" data-fundo="#3b1408">Escuro</button>
      <button type="button" data-fundo="#2f7a3a">Verde</button>
    </div>

    <div class="fundos roupas" role="group" aria-label="Roupa">
      {roupas.map((r, i) => (
        <button type="button" data-roupa={r.id} class={i === 0 ? 'ativo' : ''} title={r.desc}>{r.nome}</button>
      ))}
    </div>

    {roupas.map((r, i) => (
    <section class="roupa" data-roupa={r.id} hidden={i !== 0}>
    <p class="desc">{r.desc}</p>
    <ul class="grade">
      {animacoes.map((a) => (
        <li class="cartao">
          <div
            class="sprite"
            style={`--q:${a.quadros};--dur:${a.quadros / a.fps}s;--img:url('/jogo/sprites/bia_${r.id}_${a.arquivo}.png');--e:${ESCALA}`}
            role="img"
            aria-label={`Animação: ${a.nome}`}
          ></div>
          <h2>{a.nome}</h2>
          <p>{a.quadros} quadros · {a.fps} por segundo</p>
          <img class="tira" src={`/jogo/sprites/bia_${r.id}_${a.arquivo}.png`} alt={`Tira de quadros: ${a.nome}`} width={32 * a.quadros * 3} height={48 * 3} />
          <code>bia_{r.id}_{a.arquivo}.png</code>
        </li>
      ))}
    </ul>
    </section>
    ))}

    <h2 class="secao">Cenário: o salão</h2>
    <p class="desc">Camadas de tools/sprites/cenario.py (180×320, ampliado 2×). Posições em src/data/acarabet/salao.json.</p>
    <div class="cena" role="img" aria-label="Salão do Acarajazz com a Bia no balcão e os personagens">
      <img src="/jogo/cenario/salao_fundo.png" alt="" width="180" height="320" />
      <div id="bia-cena" class="sprite" data-pontos={JSON.stringify(pos.pontos)} data-rotas={JSON.stringify(pos.rotas)}
        style={`--q:2;--dur:1s;--img:url('/jogo/sprites/bia_baiana_parada_2q.png');--e:1;left:${pos.pontos.bancada.x}px;top:${pos.pontos.bancada.y}px;z-index:1`}></div>
      <img src="/jogo/cenario/salao_balcao.png" alt="" width="180" height="320" style="z-index:2" />
      <div class="sprite fitas" style="--q:4;--dur:1.6s;--img:url('/jogo/cenario/salao_fitas_4q.png');--e:1;--w:180;--h:40;left:0;top:0;z-index:999"></div>
      <div id="casal-cena" class="sprite" style={`--q:2;--dur:1s;--img:url('/jogo/sprites/cliente_casal_esperando_2q.png');--e:1;--w:64;--h:48;left:${pos.casal.x}px;top:${pos.casal.y}px;z-index:${10 + pos.casal.y + 48}`}></div>
      {cena.map((c) => (
        <div class="sprite" style={`--q:${c.q};--dur:${c.q / c.fps}s;--img:url('/jogo/sprites/${c.s}.png');--e:1;--w:${c.w ?? 32};--h:${c.h ?? 48};left:${c.x}px;top:${c.y}px;z-index:${10 + c.y + (c.h ?? 48)}`}></div>
      ))}
    </div>

    <h2 class="secao">Easter eggs</h2>
    <p class="desc">Personagens escondidos no cenário.</p>
    <ul class="grade">
      {easterEggs.map((a) => (
        <li class:list={['cartao', { largo: (a.w ?? 32) > 32 }]}>
          <div
            class="sprite"
            style={`--q:${a.quadros};--dur:${a.quadros / a.fps}s;--img:url('/jogo/sprites/${a.arquivo}.png');--e:${(a.w ?? 32) > 32 ? 4 : ESCALA};--w:${a.w ?? 32};--h:${a.h ?? 48}`}
            role="img"
            aria-label={`Animação: ${a.nome}`}
          ></div>
          <h2>{a.nome}</h2>
          <p>{a.desc} · {a.quadros} quadros</p>
          <code>{a.arquivo}.png</code>
        </li>
      ))}
    </ul>
  </main>
</Base>

<style>
  .pagina { max-width: 1160px; margin: 0 auto; padding: 32px var(--gutter) 64px; }
  h1 { font-size: 2.4rem; color: var(--vinho); }
  .sub { color: var(--texto-suave); margin-top: 4px; }
  .fundos { display: flex; gap: 8px; margin: 18px 0; flex-wrap: wrap; }
  .fundos button { font: 700 0.9rem var(--fonte-titulo); padding: 6px 14px; border-radius: 999px; border: 2px solid var(--vinho); background: #fff; color: var(--vinho); cursor: pointer; }
  .fundos button.ativo { background: var(--vinho); color: var(--creme); }
  .roupas button { font-size: 1rem; }
  .desc { color: var(--texto-suave); margin: 0 0 12px; }
  .grade { list-style: none; padding: 0; margin: 0; display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); }
  .cartao { background: var(--fundo-sprite, #fef5e2); border-radius: 18px; padding: 18px; text-align: center; box-shadow: var(--sombra); }
  .sprite {
    width: calc(var(--w, 32) * 1px * var(--e)); height: calc(var(--h, 48) * 1px * var(--e)); margin: 0 auto;
    background-image: var(--img); background-repeat: no-repeat;
    background-size: calc(var(--w, 32) * 1px * var(--q) * var(--e)) calc(var(--h, 48) * 1px * var(--e));
    image-rendering: pixelated;
    animation: rodar var(--dur) steps(var(--q)) infinite;
  }
  @keyframes rodar { to { background-position: calc(var(--w, 32) * -1px * var(--q) * var(--e)) 0; } }
  .largo { grid-column: span 2; }
  .cena { position: relative; width: 180px; height: 320px; transform: scale(2); transform-origin: top left; margin-bottom: 340px; }
  .cena > * { position: absolute; left: 0; top: 0; image-rendering: pixelated; }
  .cena .sprite { margin: 0; }
  @media (max-width: 560px) { .largo { grid-column: auto; } }
  .secao { font-size: 1.8rem; color: var(--vinho); margin: 40px 0 4px; }
  h2 { font-size: 1.15rem; color: var(--vinho); margin-top: 10px; }
  .cartao p { font-size: 0.85rem; color: var(--texto-suave); }
  .tira { image-rendering: pixelated; margin: 10px auto 4px; max-width: 100%; height: auto; background: rgb(0 0 0 / 0.05); }
  code { font-size: 0.75rem; color: var(--texto-suave); }
  .escuro h2, .escuro .cartao p, .escuro code { color: var(--creme); }
</style>

<script>
  // Prévia da Bia andando pelo salão (mesma lógica que o jogo vai usar, com os pontos de salao.json)
  type Ponto = { x: number; y: number; camada: string };
  const bia = document.getElementById('bia-cena');
  let roupa = 'baiana';
  document.querySelectorAll<HTMLButtonElement>('.roupas button').forEach((b) =>
    b.addEventListener('click', () => (roupa = b.dataset.roupa!)),
  );
  if (bia && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const pontos: Record<string, Ponto> = JSON.parse(bia.dataset.pontos!);
    const rotas: Record<string, string[]> = JSON.parse(bia.dataset.rotas!);
    const VEL = 40; // px por segundo
    const anim = (nome: string, q: number, fps: number, espelha = false) => {
      bia.style.setProperty('--img', `url('/jogo/sprites/bia_${roupa}_${nome}_${q}q.png')`);
      bia.style.setProperty('--q', String(q));
      bia.style.setProperty('--dur', `${q / fps}s`);
      bia.style.transform = espelha ? 'scaleX(-1)' : '';
    };
    const coloca = (x: number, y: number, camada: string) => {
      bia.style.left = `${x}px`;
      bia.style.top = `${y}px`;
      bia.style.zIndex = camada === 'atras_do_balcao' ? '1' : String(10 + Math.round(y) + 48);
    };
    const espera = (ms: number) => new Promise((r) => setTimeout(r, ms));
    const casal = document.getElementById('casal-cena');
    const casalEstado = (nome: string, q: number, fps: number) => {
      casal?.style.setProperty('--img', `url('/jogo/sprites/cliente_casal_${nome}_${q}q.png')`);
      casal?.style.setProperty('--q', String(q));
      casal?.style.setProperty('--dur', `${q / fps}s`);
    };
    const anda = (de: Ponto, para: Ponto, bandeja: boolean) =>
      new Promise<void>((fim) => {
        const dx = para.x - de.x, dy = para.y - de.y;
        if (Math.abs(dx) >= Math.abs(dy)) anim(bandeja ? 'servindo_lado' : 'andando_lado', 6, 10, dx < 0);
        else if (dy > 0) anim(bandeja ? 'servindo' : 'andando', 4, 8);
        else anim('andando_costas', 4, 8);
        const dur = (Math.hypot(dx, dy) / VEL) * 1000;
        const t0 = performance.now();
        const passo = (t: number) => {
          const k = Math.min(1, (t - t0) / dur);
          const camada = k < 0.5 ? de.camada : para.camada;
          coloca(de.x + dx * k, de.y + dy * k, camada);
          if (k < 1) requestAnimationFrame(passo);
          else fim();
        };
        requestAnimationFrame(passo);
      });
    const percorre = async (nomes: string[], bandeja: boolean) => {
      for (let i = 1; i < nomes.length; i++) await anda(pontos[nomes[i - 1]], pontos[nomes[i]], bandeja);
    };
    (async () => {
      for (;;) {
        for (const rota of Object.values(rotas)) {
          anim('mexendo', 4, 8);
          await espera(2500);
          const praCasal = rota[rota.length - 1] === 'mesa_frente';
          if (praCasal) casalEstado('esperando', 2, 2);
          await percorre(rota, true); // leva o acarajé
          anim('comemorando', 4, 8);
          if (praCasal) casalEstado('feliz', 3, 5);
          await espera(1500);
          if (praCasal) casalEstado('comendo', 4, 4);
          await percorre([...rota].reverse(), false); // volta pro balcão
        }
      }
    })();
  }

  document.querySelectorAll<HTMLButtonElement>('.roupas button').forEach((b) =>
    b.addEventListener('click', () => {
      document.querySelectorAll('.roupas button').forEach((x) => x.classList.toggle('ativo', x === b));
      document.querySelectorAll<HTMLElement>('section.roupa').forEach((s) => (s.hidden = s.dataset.roupa !== b.dataset.roupa));
    }),
  );
  document.querySelectorAll<HTMLButtonElement>('.fundos:not(.roupas) button').forEach((b) =>
    b.addEventListener('click', () => {
      document.querySelectorAll('.fundos:not(.roupas) button').forEach((x) => x.classList.remove('ativo'));
      b.classList.add('ativo');
      const escuro = b.dataset.fundo === '#3b1408' || b.dataset.fundo === '#2f7a3a';
      document.querySelectorAll<HTMLElement>('.cartao').forEach((c) => {
        c.style.setProperty('--fundo-sprite', b.dataset.fundo!);
        c.classList.toggle('escuro', escuro);
      });
    }),
  );
</script>
