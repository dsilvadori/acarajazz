---
// Aviso de cookies para quem acessa pela primeira vez. O site só usa cookies e armazenamento essenciais
// (ver /politica-de-cookies), então o aviso é informativo: some no "Entendi" e não volta mais naquele navegador.
// Começa escondido e só aparece pelo script, para não piscar para quem já fechou.
---

<aside class="aviso-cookies" data-aviso-cookies hidden aria-label="Aviso de cookies">
  <p>
    🍪 Usamos só cookies essenciais, para proteger os formulários contra robôs e guardar seu progresso no
    Acarabet. Nada de publicidade ou rastreamento. <a href="/politica-de-cookies">Política de cookies</a>
  </p>
  <button type="button" data-aviso-ok>Entendi</button>
</aside>

<style>
  .aviso-cookies {
    position: fixed; z-index: 900; left: 16px; right: 16px; bottom: 16px;
    margin-inline: auto; max-width: 620px;
    display: flex; align-items: center; gap: 16px;
    padding: 14px 16px 14px 20px; border-radius: 18px;
    background: var(--creme); color: var(--texto); box-shadow: 0 18px 40px -12px rgb(86 0 0 / 0.5);
    border: 2px solid var(--vinho);
    font-size: 0.95rem; line-height: 1.45;
    padding-bottom: calc(14px + env(safe-area-inset-bottom, 0px));
  }
  .aviso-cookies[hidden] { display: none; }
  .aviso-cookies p { margin: 0; }
  .aviso-cookies a { color: var(--vinho); font-weight: 800; text-decoration: underline; white-space: nowrap; }
  .aviso-cookies button {
    flex: none; border: 0; border-radius: 999px; padding: 10px 20px; min-height: 44px;
    background: var(--vinho); color: var(--creme); font: inherit; font-weight: 800; cursor: pointer;
  }
  .aviso-cookies button:hover { filter: brightness(1.15); }
  .aviso-cookies button:focus-visible, .aviso-cookies a:focus-visible { outline: 3px solid var(--laranja-forte); outline-offset: 2px; }
  @media (max-width: 520px) {
    .aviso-cookies { flex-direction: column; align-items: stretch; gap: 12px; }
    .aviso-cookies button { width: 100%; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .aviso-cookies:not([hidden]) { animation: sobe 0.35s ease-out; }
    @keyframes sobe { from { transform: translateY(20px); opacity: 0; } }
  }
</style>

<script>
  const CHAVE = 'acarajazz:aviso-cookies';
  const aviso = document.querySelector<HTMLElement>('[data-aviso-cookies]');
  if (aviso) {
    let visto = false;
    try { visto = localStorage.getItem(CHAVE) === '1'; } catch { /* navegador sem armazenamento: mostra o aviso */ }
    if (!visto) aviso.hidden = false;
    aviso.querySelector('[data-aviso-ok]')?.addEventListener('click', () => {
      aviso.hidden = true;
      try { localStorage.setItem(CHAVE, '1'); } catch { /* fecha só nesta visita */ }
    });
  }
</script>
