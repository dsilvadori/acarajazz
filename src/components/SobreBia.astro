---
// Slide de fotos da Bia (troca em fade automático). Para mudar: editar a lista e colocar a foto (720×900) em public/img/.
const fotos = [
  { src: '/img/bia.webp', alt: 'Chef Bia Souza de turbante branco segurando um prato de acarajés' },
  { src: '/img/bia-peixe.webp', alt: 'Chef Bia Souza segurando um peixe em frente ao Acarajazz' },
  { src: '/img/bia-massa.webp', alt: 'Chef Bia Souza batendo a massa do acarajé na cozinha da casa' },
  { src: '/img/bia-familia.webp', alt: 'Duas mulheres da família da Bia celebrando no Acarajazz', legenda: 'As mulheres da família' },
];
---

<section class="bia" id="chef" aria-labelledby="bia-titulo">
  <div class="container grade">
    <figure class="foto">
      <div class="circulo" aria-hidden="true"></div>
      <div class="slides">
        {fotos.map((f, i) => (
          <figure class:list={['slide', { ativa: i === 0 }]}>
            <img src={f.src} alt={f.alt} width="720" height="900" loading="lazy" decoding="async" />
            {f.legenda && <figcaption>{f.legenda}</figcaption>}
          </figure>
        ))}
      </div>
    </figure>

    <div class="texto">
      <p class="chamada">Quem frita é ela</p>
      <h2 class="titulo" id="bia-titulo">Chef Bia Souza</h2>
      <p class="lead">
        Baiana de ofício, a Bia cozinha desde os 7 anos e aprendeu com as mulheres da família o amor pelo
        acarajé e pela cultura baiana.
      </p>
      <p>
        Estudou gastronomia e, em 2016, levou o Acarajazz para as feiras gastronômicas com uma missão: servir
        uma culinária que valoriza a ancestralidade e o amor que só uma cozinha de herança tem, aquela passada
        de geração em geração. Depois veio o delivery e, hoje, a casa na Vila Mariana.
      </p>
      <p>
        Mais do que uma marca, o Acarajazz é feito de luta, resiliência e trabalho coletivo. Muitas mãos e
        corações envolvidos.
      </p>
      <blockquote>
        <p>Por aqui, o dendê encontra o indie rock, o acarajé acompanha a cerveja gelada e a baianidade não precisa seguir roteiro.</p>
      </blockquote>
      <p class="fecho">Acarajazz é um boteco de baianos. <strong>Para todos.</strong></p>
    </div>
  </div>
</section>

<style>
  .bia { background: var(--vinho); color: var(--creme); padding-block: var(--secao); overflow: hidden; }
  .grade { display: grid; gap: 48px; align-items: center; }
  @media (min-width: 900px) { .grade { grid-template-columns: 0.9fr 1.1fr; gap: 72px; } }

  .foto { position: relative; margin: 0 auto; width: min(100%, 420px); }
  .circulo {
    position: absolute; inset: -6% -10% auto auto;
    width: 78%; aspect-ratio: 1; border-radius: 50%;
    background: var(--laranja);
  }
  .slides {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 999px 999px var(--raio) var(--raio);
    border: 6px solid var(--creme);
    overflow: hidden;
    background: var(--vinho-escuro);
  }
  .slide { position: absolute; inset: 0; margin: 0; opacity: 0; transition: opacity 1.2s ease; }
  .slide.ativa { opacity: 1; }
  .slide img { width: 100%; height: 100%; object-fit: cover; }
  .slide figcaption {
    position: absolute; inset: auto 0 0 0; padding: 36px 16px 14px; text-align: center;
    background: linear-gradient(transparent, rgb(58 0 0 / 0.85));
    font-family: var(--fonte-titulo); font-weight: 700; color: var(--creme);
  }
  @media (prefers-reduced-motion: reduce) { .slide { transition: none; } }

  .chamada { color: var(--amarelo); }
  .titulo { color: var(--creme); }
  .lead { margin-top: 1rem; font-size: 1.25rem; font-weight: 700; max-width: 40ch; }
  .texto p + p { margin-top: 0.8rem; max-width: 48ch; opacity: 0.9; }

  .fecho { margin-top: 1.4rem; font-family: var(--fonte-titulo); font-size: 1.3rem; font-weight: 700; opacity: 1 !important; }
  .fecho strong { color: var(--amarelo); }

  blockquote p { margin: 0; opacity: 1 !important; max-width: none !important; }

  blockquote {
    margin: 1.8rem 0 0;
    padding-left: 18px;
    border-left: 5px solid var(--amarelo);
    font-family: var(--fonte-titulo);
    font-size: 1.4rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--amarelo);
    max-width: 36ch;
  }
</style>

<script>
  // Fade automático das fotos da Bia (pausa fora da tela, com a aba escondida e com "reduzir movimento")
  {
    const slides = [...document.querySelectorAll<HTMLElement>('#chef .slide')];
    const reduzir = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (slides.length > 1 && !reduzir) {
      let atual = 0;
      let visivel = false;
      new IntersectionObserver(([e]) => (visivel = e.isIntersecting)).observe(slides[0].parentElement!);
      setInterval(() => {
        if (!visivel || document.hidden) return;
        slides[atual].classList.remove('ativa');
        atual = (atual + 1) % slides.length;
        slides[atual].classList.add('ativa');
      }, 4500);
    }
  }
</script>
