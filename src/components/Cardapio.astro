---
import type { CategoriaCardapio } from '../lib/db';
import { formatarPreco } from '../lib/horario';

interface Props {
  categorias: CategoriaCardapio[];
}
const { categorias } = Astro.props;
---

<section class="cardapio" id="cardapio" aria-labelledby="cardapio-titulo">
  <div class="container">
    <div class="topo">
      <p class="chamada">Cardápio</p>
      <h2 class="titulo" id="cardapio-titulo">Chegue mais, tu não é cuscuz pra ficar abafado</h2>
    </div>

    <div class="abas" role="tablist" aria-label="Categorias do cardápio">
      {categorias.map((c, i) => (
        <button
          type="button"
          role="tab"
          id={`aba-${c.slug}`}
          aria-controls={`cat-${c.slug}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
        >
          {c.nome}
        </button>
      ))}
    </div>

    <div class="paineis">
      {categorias.map((c) => (
        <div class="painel" role="tabpanel" id={`cat-${c.slug}`} aria-labelledby={`aba-${c.slug}`}>
          <h3 class="nome-categoria">{c.nome}{c.subtitulo && <small> · {c.subtitulo}</small>}</h3>
          <ul class="itens">
            {c.itens.map((i) => (
              <li>
                <div class="linha">
                  <span class="nome">{i.nome}</span>
                  <span class="pontos" aria-hidden="true"></span>
                  <span class="preco">{formatarPreco(i.preco_centavos)}</span>
                </div>
                {(i.descricao || i.autoral || i.vegetariano || i.camarao) ? (
                  <p class="desc">
                    {i.descricao}
                    {i.vegetariano ? <span class="tag tag-v">vegetariano</span> : null}
                    {i.autoral ? <span class="tag">autoral</span> : null}
                    {i.camarao ? <span class="tag">contém camarão</span> : null}
                  </p>
                ) : null}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .cardapio { background: var(--creme); padding-block: var(--secao); }
  .topo { text-align: center; }
  .titulo { max-width: 18ch; margin-inline: auto; }

  .abas {
    position: relative;
    display: flex;
    gap: 8px;
    overflow-x: auto;
    margin: 2.2rem calc(-1 * var(--gutter)) 0;
    padding: 4px var(--gutter) 12px;
    scrollbar-width: none;
    justify-content: safe center;
  }
  .abas::-webkit-scrollbar { display: none; }
  .abas button {
    flex: none;
    font: 700 1rem var(--fonte-titulo);
    padding: 0.5em 1.15em;
    border-radius: 999px;
    border: 0;
    background: var(--creme-2);
    color: var(--vinho);
    cursor: pointer;
  }
  .abas button[aria-selected='true'] { background: var(--vinho); color: var(--creme); }

  .paineis {
    max-width: 760px;
    margin: 1.6rem auto 0;
    background: #fff;
    border-radius: var(--raio);
    padding: clamp(20px, 4vw, 40px);
    box-shadow: var(--sombra);
  }
  .nome-categoria { font-size: 1.6rem; color: var(--vinho); margin-bottom: 0.6rem; }
  .nome-categoria small { font-size: 0.6em; color: var(--laranja-forte); font-weight: 700; }

  /* Sem JS: todas as categorias aparecem em sequência. Com JS: uma por vez. */
  .com-abas .painel[hidden] { display: none; }
  .painel + .painel { margin-top: 2rem; }
  .com-abas .painel + .painel { margin-top: 0; }

  .itens { list-style: none; padding: 0; margin: 0; }
  .itens li { padding: 12px 0; border-bottom: 1px solid var(--creme-2); }
  .itens li:last-child { border-bottom: 0; }
  .linha { display: flex; align-items: baseline; gap: 10px; }
  .nome { font-family: var(--fonte-titulo); font-weight: 700; font-size: 1.12rem; color: var(--texto); line-height: 1.25; }
  .pontos { flex: 1; min-width: 16px; border-bottom: 2px dotted #e2c79c; transform: translateY(-5px); }
  .preco { font-family: var(--fonte-titulo); font-weight: 800; font-size: 1.12rem; color: var(--vinho); white-space: nowrap; }
  .preco::before { content: 'R$ '; font-size: 0.75em; font-weight: 600; }
  .desc { font-size: 0.92rem; color: var(--texto-suave); margin-top: 2px; }
  .tag {
    display: inline-block; margin-left: 6px; padding: 0 8px; border-radius: 999px;
    font-size: 0.75rem; font-weight: 700; background: var(--creme-2); color: var(--vinho); vertical-align: 1px;
  }
  .tag-v { background: #e3f1df; color: var(--verde); }
</style>

<script>
  const raiz = document.querySelector<HTMLElement>('#cardapio')!;
  const abas = [...raiz.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
  const paineis = [...raiz.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
  raiz.querySelector('.paineis')!.classList.add('com-abas');

  function ativar(aba: HTMLButtonElement, foco = false) {
    for (const a of abas) {
      const ativa = a === aba;
      a.setAttribute('aria-selected', String(ativa));
      a.tabIndex = ativa ? 0 : -1;
    }
    for (const p of paineis) p.hidden = p.id !== aba.getAttribute('aria-controls');
    if (foco) aba.focus();
    // Rola só a barra de abas (nunca a página)
    const barra = aba.parentElement!;
    barra.scrollTo({ left: aba.offsetLeft - (barra.clientWidth - aba.offsetWidth) / 2, behavior: 'smooth' });
  }
  ativar(abas[0]);

  abas.forEach((a, i) => {
    a.addEventListener('click', () => ativar(a));
    a.addEventListener('keydown', (e) => {
      const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (d) ativar(abas[(i + d + abas.length) % abas.length], true);
    });
  });
</script>
