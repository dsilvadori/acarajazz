---
import type { CategoriaCardapio } from '../lib/db';
import { formatarPreco } from '../lib/horario';

interface Props {
  categorias: CategoriaCardapio[];
}
const { categorias } = Astro.props;
---

<section class="cardapio" id="cardapio" aria-labelledby="cardapio-titulo">
  <div class="container">
    <p class="sobretitulo">Do tabuleiro pro boteco</p>
    <h2 class="titulo-secao" id="cardapio-titulo">Cardápio</h2>

    <ul class="legenda" aria-label="Legenda">
      <li><span class="selo selo-a">A</span> Autoral</li>
      <li><span class="selo selo-v">V</span> Vegetariano</li>
      <li><span class="selo selo-c">C</span> Contém camarão</li>
    </ul>

    <nav class="atalhos" aria-label="Categorias do cardápio">
      {categorias.map((c) => <a href={`#cat-${c.slug}`}>{c.nome}</a>)}
    </nav>

    <div class="grade">
      {categorias.map((c) => (
        <article class="categoria" id={`cat-${c.slug}`}>
          <header>
            <h3>{c.nome}</h3>
            {c.subtitulo && <p class="subtitulo">{c.subtitulo}</p>}
          </header>
          <ul class="itens">
            {c.itens.map((i) => (
              <li class:list={['item', { destaque: i.destaque }]}>
                <div class="linha">
                  <span class="nome">
                    {i.nome}
                    {i.autoral ? <span class="selo selo-a" title="Autoral">A</span> : null}
                    {i.vegetariano ? <span class="selo selo-v" title="Vegetariano">V</span> : null}
                    {i.camarao ? <span class="selo selo-c" title="Contém camarão">C</span> : null}
                  </span>
                  <span class="pontilhado" aria-hidden="true"></span>
                  <span class="preco"><small>R$</small> {formatarPreco(i.preco_centavos)}</span>
                </div>
                {i.descricao && <p class="descricao">{i.descricao}</p>}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <p class="rodape-cardapio">
      Chegue mais! Nossa casinha se faz de comida, afeto e conversa. Alguma questão? Diga.
      <em>Tu não é cuscuz pra ficar abafado.</em>
    </p>
  </div>
</section>

<style>
  .cardapio {
    background: var(--papel);
    padding-block: clamp(48px, 8vw, 96px);
  }

  .legenda {
    list-style: none;
    padding: 0;
    margin: 1.2rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    font-size: 0.92rem;
    color: var(--tinta-suave);
  }
  .legenda li { display: flex; align-items: center; gap: 6px; }

  .selo {
    display: inline-grid;
    place-items: center;
    width: 1.35em;
    height: 1.35em;
    border-radius: 50%;
    font-family: var(--fonte-texto);
    font-size: 0.72rem;
    font-weight: 800;
    font-style: normal;
    color: #fff;
    margin-left: 0.35em;
    vertical-align: 0.15em;
  }
  .legenda .selo { margin-left: 0; }
  .selo-a { background: var(--dende); }
  .selo-v { background: var(--quiabo); }
  .selo-c { background: var(--fita-vermelha); }

  .atalhos {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    margin: 1.4rem calc(-1 * var(--gutter)) 0;
    padding: 4px var(--gutter) 10px;
    scrollbar-width: thin;
  }
  .atalhos a {
    flex: none;
    padding: 0.4em 1em;
    border-radius: 999px;
    background: var(--creme);
    border: 2px solid var(--creme-2);
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .atalhos a:hover { border-color: var(--dende); color: var(--vinho); }

  .grade {
    margin-top: 1.6rem;
    columns: 1;
    column-gap: 28px;
  }
  @media (min-width: 760px) { .grade { columns: 2; } }
  @media (min-width: 1100px) { .grade { columns: 3; } }

  .categoria {
    break-inside: avoid;
    margin-bottom: 28px;
    padding: 22px 22px 14px;
    background: var(--creme);
    border-radius: var(--raio);
    border-top: 6px solid var(--dende);
    scroll-margin-top: 24px;
  }
  .categoria:nth-child(3n + 2) { border-top-color: var(--fita-azul); }
  .categoria:nth-child(3n + 3) { border-top-color: var(--fita-amarela); }

  .categoria h3 {
    font-size: 1.55rem;
    font-weight: 800;
    color: var(--vinho);
  }
  .subtitulo {
    font-family: var(--fonte-fita);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.78rem;
    color: var(--dende);
    margin-top: 4px;
  }

  .itens { list-style: none; padding: 0; margin: 14px 0 0; }
  .item { padding: 9px 0; border-bottom: 1px dashed var(--creme-2); }
  .item:last-child { border-bottom: 0; }

  .linha { display: flex; align-items: baseline; gap: 8px; }
  .nome { font-weight: 800; }
  .destaque .nome { color: var(--vinho); }
  .pontilhado { flex: 1; min-width: 12px; border-bottom: 2px dotted #d9b98f; transform: translateY(-4px); }
  .preco { font-weight: 800; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .preco small { font-size: 0.72em; color: var(--tinta-suave); }
  .descricao { font-size: 0.92rem; color: var(--tinta-suave); margin-top: 2px; max-width: 42ch; }

  .rodape-cardapio {
    margin-top: 12px;
    text-align: center;
    font-family: var(--fonte-titulo);
    font-size: 1.15rem;
    color: var(--tinta-suave);
    max-width: 52ch;
    margin-inline: auto;
  }
  .rodape-cardapio em { color: var(--vinho); font-weight: 700; }
</style>
