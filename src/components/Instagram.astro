---
import { getPosts, PERFIL } from '../lib/instagram';

const posts = await getPosts(6);
---

<section class="insta" id="instagram" aria-labelledby="insta-titulo">
  <div class="container">
    <div class="topo">
      <div>
        <p class="chamada">Novidades da casa</p>
        <h2 class="titulo" id="insta-titulo">@o_acarajazz</h2>
      </div>
      <a class="botao botao-vinho" href={PERFIL} target="_blank" rel="noopener">Seguir no Instagram</a>
    </div>

    <ul class="grade">
      {posts.map((p) => (
        <li>
          <a href={p.link} target="_blank" rel="noopener" aria-label={p.legenda || 'Ver post no Instagram'}>
            <img src={p.imagem} alt="" loading="lazy" decoding="async" width="720" height="900" />
            {p.video && <span class="play" aria-hidden="true">▶</span>}
            <span class="legenda">{p.legenda}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .insta { background: var(--creme); padding-block: var(--secao); }
  .topo { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 18px 24px; }

  .grade {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid; gap: 10px;
    grid-template-columns: repeat(2, 1fr);
  }
  @media (min-width: 760px) { .grade { grid-template-columns: repeat(3, 1fr); gap: 16px; } }

  .grade a {
    position: relative; display: block; overflow: hidden;
    aspect-ratio: 1; border-radius: 18px; background: var(--creme-2);
  }
  .grade img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .grade a:hover img { transform: scale(1.04); }

  .legenda {
    position: absolute; inset: auto 0 0 0;
    padding: 28px 14px 12px;
    background: linear-gradient(transparent, rgb(58 0 0 / 0.85));
    color: #fff; font-size: 0.85rem; font-weight: 700; line-height: 1.3;
    opacity: 0; transform: translateY(8px); transition: 0.25s ease;
  }
  .grade a:hover .legenda, .grade a:focus-visible .legenda { opacity: 1; transform: none; }
  @media (hover: none) { .legenda { opacity: 1; transform: none; } }

  .play {
    position: absolute; top: 10px; right: 10px; width: 32px; height: 32px; border-radius: 50%;
    display: grid; place-items: center; background: rgb(0 0 0 / 0.5); color: #fff; font-size: 0.8rem;
  }
  @media (prefers-reduced-motion: reduce) { .grade img, .legenda { transition: none; } }
</style>
