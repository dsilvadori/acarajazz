---
import type { Horario } from '../lib/db';
import { DIAS, formatarHora, agoraSP, type Status } from '../lib/horario';
import StatusAgora from './StatusAgora.astro';

interface Props {
  horarios: Horario[];
  status: Status;
  aviso: string | null;
}
const { horarios, status, aviso } = Astro.props;
const { dia: hoje } = agoraSP();

// Semana começando na segunda
const semana = [1, 2, 3, 4, 5, 6, 0].map((d) => horarios.find((h) => h.dia_semana === d)).filter((h): h is Horario => !!h);

const mapa = 'https://www.google.com/maps/search/?api=1&query=' +
  encodeURIComponent('Acarajazz, Rua Dona Inácia Uchôa, 89 - Vila Mariana, São Paulo - SP');
---

<section class="onde" id="onde" aria-labelledby="onde-titulo">
  <span id="horarios" class="ancora" aria-hidden="true"></span>
  <div class="container grade">
    <figure class="foto">
      <img src="/img/casinha.webp" alt="Mesas na calçada do Acarajazz, cheias de gente" width="1200" height="900" loading="lazy" decoding="async" />
    </figure>

    <div class="texto">
      <p class="chamada">Onde e quando</p>
      <h2 class="titulo" id="onde-titulo">A casinha abre de quinta a domingo</h2>

      <div class="status-wrap"><StatusAgora status={status} /></div>
      {aviso && <p class="aviso" role="note">{aviso}</p>}

      <table class="tabela">
        <caption class="sr-only">Dias e horários de funcionamento</caption>
        <tbody>
          {semana.map((h) => (
            <tr class:list={{ hoje: h.dia_semana === hoje, fechado: !h.abre }} aria-current={h.dia_semana === hoje ? 'date' : undefined}>
              <th scope="row">{DIAS[h.dia_semana]}</th>
              <td>
                {h.abre && h.fecha
                  ? `${formatarHora(h.abre)} – ${formatarHora(h.fecha)}`
                  : h.so_delivery ? 'Só delivery' : 'Fechado'}
              </td>
            </tr>
          ))}
        </tbody>
      </table>

      <address>
        Rua Dona Inácia Uchôa, 89 · Vila Mariana · São Paulo/SP
      </address>
      <a class="botao botao-vinho" href={mapa} target="_blank" rel="noopener">Como chegar ↗</a>
    </div>
  </div>
</section>

<style>
  .onde { position: relative; background: var(--creme); padding-block: var(--secao); }
  .ancora { position: absolute; top: 0; }
  .grade { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 900px) { .grade { grid-template-columns: 1.05fr 1fr; gap: 64px; } }

  .foto { margin: 0; }
  .foto img {
    width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover;
    border-radius: 200px 200px var(--raio) var(--raio);
    border: 6px solid #fff;
    box-shadow: var(--sombra);
  }

  .status-wrap { margin-top: 1.2rem; }
  .aviso { margin-top: 1rem; padding: 0.8em 1em; border-radius: 14px; background: var(--amarelo); color: var(--vinho); font-weight: 700; }

  .tabela { width: 100%; margin-top: 1.4rem; border-collapse: collapse; font-size: 1.05rem; }
  .tabela th, .tabela td { padding: 9px 12px; border-bottom: 1px solid var(--creme-2); }
  .tabela th { text-align: left; font-weight: 700; }
  .tabela td { text-align: right; font-family: var(--fonte-titulo); font-weight: 700; color: var(--vinho); font-variant-numeric: tabular-nums; }
  .fechado th, .fechado td { color: var(--texto-suave); font-weight: 500; }
  .hoje th, .hoje td { background: var(--vinho); color: var(--creme); }
  .hoje th { border-radius: 12px 0 0 12px; }
  .hoje td { border-radius: 0 12px 12px 0; }

  address { font-style: normal; margin: 1.4rem 0 1rem; color: var(--texto-suave); }
</style>
