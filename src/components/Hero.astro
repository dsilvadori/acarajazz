---
import type { Status } from '../lib/horario';
import StatusAgora from './StatusAgora.astro';

interface Props {
  status: Status;
}
const { status } = Astro.props;
---

<header class="hero" id="inicio">
  <!-- Fitinhas do Bonfim: finas, paradas, só a curva -->
  <svg class="fitas" viewBox="0 0 1440 160" preserveAspectRatio="none" aria-hidden="true">
    <path d="M-20,70 C 260,20 480,120 760,70 S 1200,10 1460,50" stroke="var(--fita-amarela)" />
    <path d="M-20,92 C 280,42 500,142 780,92 S 1220,32 1460,72" stroke="var(--fita-azul)" />
    <path d="M-20,114 C 300,64 520,164 800,114 S 1240,54 1460,94" stroke="var(--fita-vermelha)" />
  </svg>

  <nav class="menu container" aria-label="Principal">
    <a href="#cardapio">Cardápio</a>
    <a href="#delivery">Delivery</a>
    <a href="#eventos" class="so-desktop">Eventos</a>
    <a href="#onde" class="so-desktop">Onde estamos</a>
    <a class="botao botao-vinho whats" href="https://wa.me/5511979564494" target="_blank" rel="noopener">WhatsApp</a>
  </nav>

  <div class="conteudo container">
    <div class="logo">
      <img src="/img/logo.webp" alt="Acarajazz" width="900" height="900" fetchpriority="high" />
    </div>

    <div class="texto">
      <p class="chamada-hero">Boteco de baianos · Vila Mariana</p>
      <h1>Acarajé de lei, dendê e baianidade. <span>Para todos.</span></h1>
      <p class="apoio">
        Tem o acarajé tradicional e o <strong>Acarajazz</strong>, nosso acarajé vegano. Além de moquecas,
        caldos e comidas típicas, regionais e autorais.
      </p>
      <div class="status-wrap"><StatusAgora status={status} /></div>
      <div class="acoes">
        <a class="botao botao-vinho" href="#cardapio">Ver cardápio</a>
        <a class="botao botao-contorno" href="#delivery">Peça no delivery</a>
      </div>
    </div>
  </div>
</header>

<style>
  .hero {
    position: relative;
    z-index: 2;
    background: var(--laranja);
    /* ponta em V, como a flâmula do banner */
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 56px), 50% 100%, 0 calc(100% - 56px));
    padding-bottom: 170px;
    overflow: hidden;
  }

  .fitas {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 40px;
    width: 100%;
    height: 130px;
    pointer-events: none;
  }
  .fitas path { fill: none; stroke-width: 7; stroke-linecap: round; vector-effect: non-scaling-stroke; }

  .menu {
    position: relative;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: clamp(14px, 3vw, 32px);
    padding-block: 20px;
    font-family: var(--fonte-titulo);
    font-weight: 700;
    font-size: 1.02rem;
  }
  .menu a:not(.botao) { color: var(--vinho); text-decoration: none; }
  .menu a:not(.botao):hover { text-decoration: underline; text-underline-offset: 4px; }
  .menu .whats { padding: 0.5em 1.2em; font-size: 0.98rem; }
  @media (max-width: 720px) { .so-desktop { display: none; } }

  .conteudo {
    position: relative;
    display: grid;
    align-items: center;
    gap: 8px 56px;
    padding-top: 8px;
  }
  @media (min-width: 900px) {
    .conteudo { grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); padding-top: 24px; }
  }

  .logo { width: min(100%, 520px); margin-inline: auto; }
  .logo img { width: 100%; height: auto; filter: drop-shadow(0 18px 24px rgb(86 0 0 / 0.25)); }
  @media (max-width: 899px) { .logo { width: min(78vw, 400px); } }

  .texto { text-align: center; }
  @media (min-width: 900px) { .texto { text-align: left; } }

  .chamada-hero {
    font-family: var(--fonte-titulo);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--vinho);
    font-size: 1rem;
  }
  h1 {
    margin-top: 0.4rem;
    font-size: clamp(2.2rem, 5.2vw, 3.6rem);
    color: var(--vinho);
    line-height: 1.02;
  }
  h1 span { color: var(--creme); text-shadow: 3px 3px 0 var(--vinho); white-space: nowrap; }

  .apoio {
    margin-top: 1rem;
    font-size: 1.12rem;
    color: var(--vinho-escuro);
    max-width: 44ch;
    margin-inline: auto;
  }
  @media (min-width: 900px) { .apoio { margin-inline: 0; } }

  .status-wrap { margin-top: 1.4rem; }
  .acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 1.4rem;
    justify-content: center;
  }
  @media (min-width: 900px) { .acoes { justify-content: flex-start; } }
</style>
