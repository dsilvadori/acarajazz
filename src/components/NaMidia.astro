---
import { MATERIAS } from '../data/midia';
---

{MATERIAS.length > 0 && (
  <section class="midia" id="midia" aria-labelledby="midia-titulo">
    <div class="container">
      <div class="topo">
        <p class="chamada">Acarajazz na mídia</p>
        <h2 class="titulo" id="midia-titulo">Deu o que falar</h2>
      </div>

      <ul class="lista">
        {MATERIAS.map((m) => (
          <li>
            <a class="cartao" href={m.link} target="_blank" rel="noopener">
              {m.imagem && <img src={m.imagem} alt="" width="480" height="360" loading="lazy" decoding="async" />}
              <div class="corpo">
                <span class="tipo">{m.tipo}{m.data && ` · ${m.data}`}</span>
                <h3>{m.veiculo}</h3>
                <p>{m.titulo}</p>
                <span class="ver">{m.link.includes('youtube.com') ? 'Assistir' : 'Ver matéria'} ↗</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .midia { background: var(--creme); padding-block: var(--secao); }
  .topo { text-align: center; }

  .lista {
    list-style: none; padding: 0; margin: 2.4rem 0 0;
    display: grid; gap: 20px;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }
  .cartao {
    display: flex; flex-direction: column; height: 100%;
    background: #fff; border-radius: var(--raio); overflow: hidden;
    text-decoration: none; color: var(--texto);
    box-shadow: var(--sombra);
    border-top: 6px solid var(--laranja);
    transition: transform 0.2s ease;
  }
  .lista li:nth-child(3n + 2) .cartao { border-top-color: var(--vinho); }
  .lista li:nth-child(3n + 3) .cartao { border-top-color: var(--amarelo); }
  .cartao:hover { transform: translateY(-4px); }
  .cartao img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  .corpo { display: flex; flex-direction: column; gap: 6px; padding: 22px; flex: 1; }
  .tipo {
    align-self: flex-start; padding: 2px 10px; border-radius: 999px;
    background: var(--creme-2); color: var(--vinho);
    font-family: var(--fonte-titulo); font-weight: 700; font-size: 0.82rem;
  }
  h3 { font-size: 1.45rem; color: var(--vinho); margin-top: 4px; }
  .corpo p { color: var(--texto-suave); }
  .ver { margin-top: auto; padding-top: 10px; font-family: var(--fonte-titulo); font-weight: 700; color: var(--laranja-forte); }

  @media (prefers-reduced-motion: reduce) { .cartao { transition: none; } }
</style>
