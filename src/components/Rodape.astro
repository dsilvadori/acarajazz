---
interface Props {
  /** Cor da seção acima (fundo atrás das fitinhas) */
  acima?: string;
}
const { acima = 'var(--creme)' } = Astro.props;
const ano = new Date().getFullYear();
---

<footer class="rodape">
  <svg class="fitas" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true" style={`background:${acima}`}>
    <path d="M0,30 C 360,6 720,56 1080,30 S 1360,14 1440,24" stroke="var(--fita-amarela)" />
    <path d="M0,44 C 360,20 720,70 1080,44 S 1360,28 1440,38" stroke="var(--fita-azul)" />
    <path d="M0,58 C 360,34 720,84 1080,58 S 1360,42 1440,52" stroke="var(--fita-vermelha)" />
  </svg>

  <div class="container grade">
    <div class="marca">
      <img src="/img/logo.webp" alt="Acarajazz" width="160" height="160" loading="lazy" />
      <p>Boteco de baianos.<br />Para todos.</p>
    </div>

    <div>
      <h2>Onde</h2>
      <address>Rua Dona Inácia Uchôa, 89<br />Vila Mariana · São Paulo/SP</address>
      <p class="pequeno">Qui e sex 17h–23h · Sáb 12h–23h30<br />Dom 12h–17h30 · Quarta: só delivery</p>
    </div>

    <div>
      <h2>Fale com a gente</h2>
      <ul>
        <li><a href="/whatsapp" target="_blank" rel="noopener">WhatsApp (11) 97956-4494</a></li>
        <li><a href="mailto:acarajazz.contato@gmail.com">acarajazz.contato@gmail.com</a></li>
        <li><a href="https://www.instagram.com/o_acarajazz/" target="_blank" rel="noopener">@o_acarajazz</a></li>
      </ul>
    </div>

    <div>
      <h2>Da mesma turma</h2>
      <a class="kangaca" href="https://kangaca.com.br" target="_blank" rel="noopener">Kangaça · Cozinha de encontros ↗</a>
    </div>
  </div>

  <div class="container base">
    <p>© {ano} Acarajazz</p>
    <nav class="legal" aria-label="Políticas">
      <a href="/politica-de-privacidade">Política de privacidade</a>
      <a href="/politica-de-cookies">Política de cookies</a>
    </nav>
  </div>
</footer>

<style>
  .rodape { background: var(--vinho); color: var(--creme); }
  .fitas { width: 100%; height: 40px; display: block; }
  .fitas path { fill: none; stroke-width: 7; }

  .grade {
    display: grid; gap: 32px;
    padding-block: 56px 32px;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    align-items: start;
  }
  .marca img { width: 120px; height: auto; margin-bottom: 10px; }
  .marca p { font-family: var(--fonte-titulo); font-weight: 700; font-size: 1.15rem; line-height: 1.3; }
  h2 { font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--amarelo); margin-bottom: 10px; }
  address { font-style: normal; line-height: 1.5; }
  ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
  a { color: var(--creme); }
  a:hover { color: var(--amarelo); }
  .pequeno { font-size: 0.88rem; opacity: 0.8; margin-top: 8px; }
  .kangaca { font-weight: 700; }

  .base {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px;
    padding-block: 18px 28px; border-top: 1px solid rgb(254 245 226 / 0.15);
    font-size: 0.85rem; opacity: 0.8;
  }
  .legal { display: flex; flex-wrap: wrap; gap: 6px 20px; }
</style>
