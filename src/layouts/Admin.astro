---
import '../styles/global.css';

interface Props {
  titulo: string;
}
const { titulo } = Astro.props;
const atual = Astro.url.pathname;
const menu = [
  { href: '/admin', texto: 'Resumo' },
  { href: '/admin/contatos?tipo=evento', base: '/admin/contatos', tipo: 'evento', texto: 'Eventos' },
  { href: '/admin/contatos?tipo=curso', base: '/admin/contatos', tipo: 'curso', texto: 'Curso' },
  { href: '/admin/cardapio', texto: 'Cardápio' },
  { href: '/admin/horarios', texto: 'Horários e avisos' },
];
const tipoAtual = Astro.url.searchParams.get('tipo');
const ativo = (m: (typeof menu)[number]) =>
  m.base ? atual.startsWith(m.base) && (tipoAtual === m.tipo || (!tipoAtual && m.tipo === 'evento' && atual === m.base)) : atual === m.href;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{titulo} · Painel Acarajazz</title>
    <link rel="icon" href="/favicon-64.png" type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Nunito:wght@400;600;700;800&display=swap" />
  </head>
  <body class="admin">
    <header class="topo">
      <div class="barra">
        <a class="marca" href="/admin"><img src="/favicon-64.png" alt="" width="34" height="34" /> Painel Acarajazz</a>
        <span class="sessao">
          <span class="usuario">{Astro.locals.usuario}</span>
          <form method="post" action="/admin/sair"><button type="submit" class="sair">Sair</button></form>
        </span>
      </div>
      <nav class="abas" aria-label="Painel">
        {menu.map((m) => <a href={m.href} aria-current={ativo(m) ? 'page' : undefined}>{m.texto}</a>)}
        <a href="/" class="ver-site" target="_blank" rel="noopener">Ver site ↗</a>
      </nav>
    </header>
    <main class="conteudo">
      <h1>{titulo}</h1>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  body.admin { background: #f7f2ea; font-size: 1rem; }
  .admin .topo { background: var(--vinho); color: var(--creme); position: sticky; top: 0; z-index: 10; }
  .admin .barra { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 12px var(--gutter) 6px; }
  .admin .marca { display: flex; align-items: center; gap: 10px; font-family: var(--fonte-titulo); font-weight: 800; font-size: 1.2rem; text-decoration: none; color: var(--creme); }
  .admin .sessao { display: flex; align-items: center; gap: 12px; min-width: 0; }
  .admin .usuario { font-size: 0.85rem; opacity: 0.8; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .admin .sair { font: 700 0.85rem var(--fonte-texto); color: var(--creme); background: transparent; border: 2px solid rgb(254 245 226 / 0.5); border-radius: 999px; padding: 4px 12px; cursor: pointer; }
  .admin .sair:hover { border-color: var(--creme); }
  @media (max-width: 520px) { .admin .usuario { display: none; } }
  .admin .abas { display: flex; gap: 4px; overflow-x: auto; padding: 0 var(--gutter); scrollbar-width: none; }
  .admin .abas a {
    flex: none; padding: 10px 14px; text-decoration: none; color: var(--creme); opacity: 0.8;
    font-family: var(--fonte-titulo); font-weight: 700; border-bottom: 4px solid transparent;
  }
  .admin .abas a[aria-current='page'] { opacity: 1; border-bottom-color: var(--laranja); }
  .admin .abas .ver-site { margin-left: auto; }
  .admin .conteudo { max-width: 1200px; margin: 0 auto; padding: 24px var(--gutter) 64px; }
  .admin h1 { font-size: clamp(1.7rem, 4vw, 2.3rem); color: var(--vinho); margin-bottom: 18px; }
  .admin h2 { font-size: 1.3rem; color: var(--vinho); }

  .admin .painel { background: #fff; border-radius: 16px; padding: 18px; box-shadow: 0 6px 20px -14px rgb(86 0 0 / 0.4); }
  .admin .aviso-ok { background: #e4f3df; color: #1f4d1c; padding: 10px 14px; border-radius: 12px; font-weight: 700; margin-bottom: 16px; }
  .admin .vazio { padding: 32px; text-align: center; color: var(--texto-suave); }

  .admin input:not([type='checkbox'], [type='radio']), .admin select, .admin textarea {
    font: inherit; padding: 9px 12px; border-radius: 10px; border: 2px solid var(--creme-2); background: #fff; color: var(--texto); width: 100%;
  }
  .admin input:focus, .admin select:focus, .admin textarea:focus { outline: none; border-color: var(--laranja); }
  .admin label { font-weight: 700; font-size: 0.9rem; color: var(--vinho); }
  .admin .botao { padding: 0.6em 1.2em; font-size: 0.95rem; }
  .admin .botao-perigo { background: #fff; color: var(--fita-vermelha); box-shadow: inset 0 0 0 2px var(--fita-vermelha); }

  .admin .selo { display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: 0.8rem; font-weight: 800; white-space: nowrap; }
  .admin .selo-novo { background: var(--laranja); color: var(--vinho); }
  .admin .selo-em_contato { background: #dbe8f7; color: #1f4f8a; }
  .admin .selo-orcamento { background: #fdf0c4; color: #7a5a00; }
  .admin .selo-fechado { background: #e4f3df; color: #1f4d1c; }
  .admin .selo-perdido { background: #eee; color: #666; }
</style>
